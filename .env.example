# Copy to .env.local.

# Supabase (Dashboard → Project Settings → API Keys).
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: used with the signed-in user's session, so RLS applies.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server-only (admin user management, public site data). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# First admin account, created by `npm run bootstrap-admin`. Sign in at /admin/login with these.
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=change-me
